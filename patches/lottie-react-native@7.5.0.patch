+package com.airbnb.android.react.lottie
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.drawable.Drawable
+import com.airbnb.lottie.LottieAnimationView
+
+/**
+ * A Lottie view that redraws at its animation's own frame rate, not on every vsync of a 120 Hz
+ * panel. Lottie's setUseCompositionFrameRate rounds the frame it draws to the composition's
+ * frames, but lottie-android 6.7.1 still asks for a redraw on every vsync: its animator compares
+ * the unrounded frame when it decides whether to notify. While the animation plays, this view
+ * redraws when the rounded frame changes and ignores its drawable's own requests. It cannot drop
+ * only some of them: the drawable asks again only after it has been drawn.
+ */
+internal class CompositionRateLottieView(context: Context) : LottieAnimationView(context) {
+    private var drawnFrame = -1
+
+    init {
+        setUseCompositionFrameRate(true)
+        addAnimatorUpdateListener { if (frame != drawnFrame) invalidate() }
+    }
+
+    override fun invalidateDrawable(dr: Drawable) {
+        if (dr === drawable && isAnimating) return
+        super.invalidateDrawable(dr)
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        drawnFrame = frame
+        super.onDraw(canvas)
+    }
+}
