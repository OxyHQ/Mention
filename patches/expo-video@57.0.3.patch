+/**
+ * `HTMLMediaElement.play()` rejects with `AbortError` when the element leaves the
+ * document, is paused, or is reloaded before the request settles. All three are
+ * routine teardown — a React view unmounting mid-play is the common one — so the
+ * dropped promise turned ordinary navigation into an uncaught rejection.
+ *
+ * Only `AbortError` is absorbed. Every other rejection is rethrown, which leaves
+ * it exactly as unhandled as it is today, so an autoplay-policy refusal
+ * (`NotAllowedError`) still surfaces.
+ */
+function playIgnoringTeardownAbort(video) {
+    const started = video.play();
+    started?.catch((error) => {
+        if (error?.name !== 'AbortError') {
+            throw error;
+        }
+    });
+}
