{
  "name": "@mention/e2e",
  "version": "1.0.0",
  "description": "Real-browser release gate: runs the candidate web build at the production origin before it is promoted",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "install-browser": "playwright install --with-deps chromium",
    "lint": "tsc --noEmit && bun run test:identity-evidence",
    "test:identity-evidence": "node --test coldIdentityEvidence.test.mjs",
    "clean": "rm -rf playwright-report test-results"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
