{
  "name": "@mention/backend",
  "version": "1.0.0",
  "description": "Express 5 / Drizzle on PostgreSQL / Socket.io backend for Mention \u2014 the REST API, ActivityPub federation, and web shell",
  "license": "UNLICENSED",
  "author": "Mention Team",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "backfill:multilingual-trends": "bun src/scripts/backfillMultilingualTrends.ts",
    "backfill:custom-emoji": "bun src/scripts/cleanFederatedCustomEmoji.ts",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clarity.surf/sdk": "^0.4.0",
    "@crowdsource.you/contracts": "1.1.0",
    "@crowdsource.you/core": "1.4.0",
    "@mention/shared-types": "workspace:*",
    "@mercaria.co/sdk": "^0.1.0",
    "@oxy.so/contracts": "catalog:",
    "@oxy.so/core": "catalog:",
    "@oxy.so/db": "^1.0.0",
    "@oxy.so/federation": "^2.0.0",
    "@oxy.so/mcp": "catalog:",
    "@oxy.so/protocol": "^1.1.0",
    "@oxy.so/utils": "^1.0.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@syra.fm/sdk": "catalog:",
    "bullmq": "^6.3.8",
    "compression": "^1.8.2",
    "drizzle-orm": "0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-slow-down": "^3.1.1",
    "firebase-admin": "^14.5.0",
    "he": "^1.2.0",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "catalog:",
    "pino": "^10.3.1",
    "postgres": "3.4.9",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "sanitize-html": "^2.17.7",
    "socket.io": "^4.8.3",
    "tinyld": "^1.3.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/compression": "^1.8.1",
    "@types/he": "^1.2.3",
    "@types/jsonwebtoken": "catalog:",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  }
}
