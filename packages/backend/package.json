{
  "name": "@mention/backend",
  "version": "1.0.0",
  "description": "Express 5 / Mongoose / Socket.io backend for Mention — the REST API, ActivityPub federation, and web shell",
  "license": "MIT",
  "author": "Mention Team",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "migrate": "bun scripts/migrate.ts",
    "migrate:dev": "NODE_ENV=development bun scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mention/shared-types": "workspace:*",
    "@oxyhq/contracts": "catalog:",
    "@oxyhq/core": "catalog:",
    "@oxyhq/crowdsource": "0.3.0",
    "@oxyhq/crowdsource-contracts": "0.3.0",
    "@oxyhq/crowdsource-express": "0.3.0",
    "@oxyhq/db": "^0.1.0",
    "@oxyhq/federation": "^0.14.1",
    "@oxyhq/protocol": "^0.1.6",
    "@socket.io/redis-adapter": "^8.3.0",
    "@syra.fm/sdk": "catalog:",
    "bullmq": "^5.80.4",
    "compression": "^1.8.1",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-slow-down": "^3.1.0",
    "firebase-admin": "^13.10.0",
    "he": "^1.2.0",
    "helmet": "^8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "catalog:",
    "mongoose": "^8.24.1",
    "pino": "^10.3.1",
    "postgres": "3.4.9",
    "prom-client": "^15.1.3",
    "redis": "^5.12.1",
    "sanitize-html": "^2.17.6",
    "socket.io": "^4.8.3",
    "tinyld": "^1.3.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@oxyhq/crowdsource-testing": "0.3.0",
    "@types/compression": "^1.8.1",
    "@types/he": "^1.2.3",
    "@types/jsonwebtoken": "catalog:",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "0.31.10",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^6.3.4",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
