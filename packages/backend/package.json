{
  "name": "@mention/backend",
  "version": "1.0.0",
  "description": "Express 5 / Drizzle on PostgreSQL / Socket.io backend for Mention — the REST API, ActivityPub federation, and web shell",
  "license": "UNLICENSED",
  "author": "Mention Team",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:check-locks": "oxy-db-check-migration-locks --migrations=drizzle --after=77 --hot-tables=bookmarks,federated_actors,likes,mutes,notifications,post_attachments,post_media,post_safety_assessments,posts,user_settings",
    "backfill:multilingual-trends": "bun src/scripts/backfillMultilingualTrends.ts",
    "backfill:custom-emoji": "bun src/scripts/cleanFederatedCustomEmoji.ts",
    "sitemaps:build": "bun src/scripts/buildSitemaps.ts",
    "test": "bun run test:vitest && bun run test:bun",
    "test:vitest": "node ../../node_modules/vitest/vitest.mjs run",
    "test:bun": "bun --no-env-file runBunTests.ts",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@alia.onl/sdk": "22.10.1",
    "@aws-sdk/credential-provider-node": "3.972.89",
    "@clarity.surf/sdk": "0.10.0",
    "@crowdsource.you/contracts": "1.1.1",
    "@crowdsource.you/core": "3.1.0",
    "@kaana.ai/contracts": "8.0.1",
    "@kaana.ai/sdk": "3.3.0",
    "@mention/shared-types": "workspace:*",
    "@mercaria.co/sdk": "0.8.0",
    "@oxy.so/contracts": "catalog:",
    "@oxy.so/core": "catalog:",
    "@oxy.so/db": "^1.4.0",
    "@oxy.so/federation": "^2.12.0",
    "@oxy.so/mcp": "catalog:",
    "@oxy.so/mention-contracts": "workspace:*",
    "@oxy.so/protocol": "catalog:",
    "@oxy.so/telemetry": "^2.1.0",
    "@oxy.so/utils": "catalog:",
    "@peable.to/sdk": "0.5.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@syra.fm/sdk": "catalog:",
    "bullmq": "^6.5.0",
    "compression": "^1.8.2",
    "drizzle-orm": "0.45.4",
    "eld": "^2.1.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-slow-down": "^3.1.1",
    "firebase-admin": "^14.5.0",
    "he": "^2.0.0",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "catalog:",
    "pino": "^10.4.0",
    "postgres": "4.0.0",
    "redis": "^6.3.0",
    "sanitize-html": "^2.18.1",
    "socket.io": "^4.8.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oxy.so/mention-sdk": "workspace:*",
    "@types/bun": "catalog:",
    "@types/compression": "^1.8.1",
    "@types/he": "^1.2.3",
    "@types/jsonwebtoken": "catalog:",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "vitest": "^5.0.5"
  }
}
