# Mention backend runtime configuration
#
# Copy this file to `.env` for local development. In AWS, secret values live in
# SSM SecureString parameters and are injected by the ECS task definition.
# Blank optional values are treated as absent; malformed supplied values fail
# fast in `src/config/index.ts`.

# Core ------------------------------------------------------------------------
NODE_ENV=development
PORT=4110
LOG_LEVEL=debug
# REQUIRED. The store the server actually opens. `docker-compose.yml` sets it to
# its own `postgres` service; this value is the one that pairs with
# `docker compose -f docker-compose.postgres.yml up -d postgres`, which is the
# database that sits beside `bun run dev:backend` and the test suite.
DATABASE_URL=postgres://mention:mention@127.0.0.1:5433/mention_dev

# NOT required to boot, and not read by the server at all. Set it ONLY to run
# `scripts/backfill-mongo-to-postgres.ts`, which names it as its SOURCE database
# and asserts it itself — and point it at the database you mean to COPY FROM,
# which is not a local one.
MONGODB_URI=
MONGODB_READ_PREFERENCE=primary
FRONTEND_URL=http://localhost:8110
MENTION_PUBLIC_API_URL=http://localhost:4110

# Mongo tuning ----------------------------------------------------------------
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=60000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=20000
MONGODB_HEARTBEAT_FREQUENCY_MS=10000
MONGODB_MAX_RETRIES=5

# Redis / Valkey --------------------------------------------------------------
# Optional for HTTP availability. Without a distributed lock, singleton jobs
# stay paused; cache and queue features degrade instead of self-electing.
REDIS_URL=redis://localhost:6379
# REDIS_URI=                       # legacy URL alias; must match REDIS_URL
# REDIS_HOST=                      # explicit host-mode alternative
# REDIS_PORT=6379
# REDIS_PASSWORD=                  # [SECRET]
# REDIS_DB=0

# Public origins and upstream services ----------------------------------------
MENTION_FRONTEND_ORIGIN=https://mention.earth
MENTION_WEB_ORIGIN=https://mention.earth
MENTION_API_ORIGIN=https://api.mention.earth
WEB_SHELL_ORIGIN=https://mention-frontend.pages.dev
OXY_API_URL=https://api.oxy.so
OXY_MEDIA_CDN_ORIGIN=https://cloud.oxy.so
ALIA_API_URL=https://api.alia.onl
SYRA_API_URL=https://api.syra.fm

# Oxy service identity ---------------------------------------------------------
OXY_SERVICE_API_KEY=               # [SECRET] pair with OXY_SERVICE_API_SECRET
OXY_SERVICE_API_SECRET=            # [SECRET]
# OXY_SERVICE_TOKEN=               # [SECRET] transitional static-token fallback
MENTION_OXY_CLIENT_ID=

# Privacy-preserving rate-limit keying. A dedicated value is preferred. In
# production, the already-required MCP key is the domain-separated fallback.
# IP_HASH_SALT=                    # [SECRET] at least 16 characters
# DEVICE_ID_SALT=                  # [SECRET] transitional alias

# Federation and external connectors ------------------------------------------
FEDERATION_ENABLED=true
FEDERATION_DOMAIN=mention.earth
# ACTOR_DOMAIN=mention.earth
# OXY_IDENTITY_APEX=oxy.so
FEDERATION_MAX_CONTENT_LENGTH=50000
FEDERATION_DELIVERY_RETRIES=5
FEDERATION_BLOCKED_DOMAINS=
FEDERATION_MEDIA_CACHE_WRITE_ENABLED=false

ATPROTO_ENABLED=false
ATPROTO_APPVIEW=public.api.bsky.app
ATPROTO_PLC_DIRECTORY=plc.directory
ATPROTO_BRIDGE_ENABLED=false

# MCP OAuth / linked accounts -------------------------------------------------
MENTION_MCP_PUBLIC_URL=https://mcp.mention.earth
MENTION_MCP_JWT_SECRET=             # [SECRET][required in production] >=32 chars
MCP_LINK_TOKEN_TTL_SECONDS=900
MCP_MAX_BUNDLE_MEMBERS=8
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_AUTH_CODE_TTL_SECONDS=300
# Space- or comma-separated absolute callback URLs:
# MCP_OAUTH_REDIRECT_URIS_CLAUDE=
# MCP_OAUTH_REDIRECT_URIS_CHATGPT=

# MTN signed records / self-hosted nodes ---------------------------------------
# Configure the signing group together or leave every value blank.
MENTION_DID=
MENTION_PRIVATE_KEY=               # [SECRET]
MENTION_PUBLIC_KEY=
# MENTION_NODE_PUBLIC_KEY=
# MENTION_NODE_BASE_URL=

# Optional product integrations ------------------------------------------------
POST_CLASSIFICATION_ENABLED=false
ALIA_API_KEY=                      # [SECRET] required only when classification is enabled

GIF_LIBRARY_WRITE_ENABLED=true
KLIPY_APP_KEY=                     # [SECRET] required for production GIF writes
KLIPY_MEDIA_HOSTS=klipy.com
GIF_MEDIA_PROXY_SECRET=            # [SECRET] >=32 chars when configured
FFMPEG_PATH=ffmpeg

# Firebase push notifications: configure both or neither.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=   # [SECRET]

# Internal metrics -------------------------------------------------------------
INTERNAL_METRICS_ENABLED=false
INTERNAL_METRICS_TOKEN=            # [SECRET] >=32 chars when enabled
METRICS_ALLOWED_IPS=               # exact comma-separated private scraper IPs

# Bounded cache TTLs (seconds) -------------------------------------------------
CACHE_USER_TTL=300
CACHE_POST_TTL=120
CACHE_FEED_TTL=900
CACHE_FOLLOW_TTL=600
FEDIVERSE_SHARING_CACHE_TTL_SECONDS=600
VIEWER_RECENT_TOPICS_TTL_SECONDS=21600
USER_SUMMARY_CACHE_TTL_SECONDS=600
DWELL_AGGREGATE_TTL_SECONDS=604800
SYRA_PODCAST_CACHE_TTL_SECONDS=300

# Feed experiments -------------------------------------------------------------
# FOR_YOU_DISCOVERY_GATE_AB=on
# FOR_YOU_DISCOVERY_GATE=default
# FOR_YOU_PHASE2B_SIGNALS=default
