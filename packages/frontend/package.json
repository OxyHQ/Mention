{
  "name": "@mention/frontend",
  "main": "expo-router/entry",
  "version": "2.0.0",
  "description": "Expo / React Native / Expo Router universal app for Mention",
  "license": "UNLICENSED",
  "scripts": {
    "start": "RCT_METRO_PORT=8110 expo start --reset-cache --tunnel --clear",
    "start:local": "RCT_METRO_PORT=8110 expo start --reset-cache --clear",
    "dev": "RCT_METRO_PORT=8110 expo start --reset-cache --tunnel --clear",
    "dev:local": "RCT_METRO_PORT=8110 expo start --reset-cache --clear",
    "clear-cache": "bun ./scripts/clear-cache.js",
    "android": "RCT_METRO_PORT=8110 expo run:android",
    "ios": "RCT_METRO_PORT=8110 expo run:ios",
    "web": "RCT_METRO_PORT=8110 expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "build:analyze": "expo export --platform web --output-dir dist --source-maps external",
    "build:apk": "eas build --platform android --profile apk --local",
    "build:apk:cloud": "eas build --platform android --profile apk",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:preview": "eas build --platform android --profile preview",
    "test": "node ../../node_modules/jest/bin/jest.js --watchAll=false --runInBand",
    "test:coverage": "node ../../node_modules/jest/bin/jest.js --watchAll=false --runInBand --coverage",
    "coverage:check": "node ./scripts/coverage-policy.mjs",
    "coverage:record": "node ./scripts/coverage-policy.mjs --record",
    "coverage:policy-selftest": "node ./scripts/test-coverage-policy.mjs",
    "typecheck": "node ./scripts/typecheck.mjs",
    "lint": "expo lint",
    "clean": "rm -rf dist .expo",
    "analyze-bundle": "bun ./scripts/analyze-bundle.js"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@oxyhq/services/ui/client$": "<rootDir>/../../node_modules/@oxyhq/services/lib/commonjs/ui/client.js",
      "^@oxyhq/core/logger$": "<rootDir>/../../node_modules/@oxyhq/core/dist/cjs/logger/index.js",
      "^@oxyhq/contracts$": "<rootDir>/../../node_modules/@oxyhq/contracts/dist/cjs/index.js"
    },
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/__tests__/**",
      "!**/*.test.{ts,tsx}",
      "!**/*.d.ts",
      "!android/**",
      "!ios/**",
      "!dist/**",
      "!.expo/**",
      "!node_modules/**"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 27.8,
        "branches": 23.3,
        "functions": 23.5,
        "lines": 28.4
      },
      "./components/providers/AccountSwitchReset.tsx": {
        "statements": 98.03,
        "branches": 93.18,
        "functions": 100,
        "lines": 100
      },
      "./lib/viewerQueryKeys.ts": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "dependencies": {
    "@alia.onl/sdk": "^7.1.1",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@expo/vector-icons": "^15.1.1",
    "@floating-ui/react-dom": "^2.1.9",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.1.2",
    "@mention/shared-types": "workspace:*",
    "@oxyhq/bloom": "catalog:",
    "@oxyhq/contracts": "catalog:",
    "@oxyhq/core": "catalog:",
    "@oxyhq/services": "catalog:",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@shopify/flash-list": "2.0.2",
    "@syra.fm/sdk": "catalog:",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.6",
    "axios": "^1.18.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
