{
  "name": "@mention/frontend",
  "main": "expo-router/entry",
  "version": "2.0.0",
  "description": "Expo / React Native / Expo Router universal app for Mention",
  "license": "UNLICENSED",
  "scripts": {
    "start": "RCT_METRO_PORT=8110 expo start --reset-cache --tunnel --clear",
    "start:local": "RCT_METRO_PORT=8110 expo start --reset-cache --clear",
    "dev": "RCT_METRO_PORT=8110 expo start --reset-cache --tunnel --clear",
    "dev:local": "RCT_METRO_PORT=8110 expo start --reset-cache --clear",
    "clear-cache": "bun ./scripts/clear-cache.js",
    "android": "RCT_METRO_PORT=8110 expo run:android",
    "ios": "RCT_METRO_PORT=8110 expo run:ios",
    "web": "RCT_METRO_PORT=8110 expo start --web",
    "build": "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1 EXPO_UNSTABLE_TREE_SHAKING=1 expo export --platform web --output-dir dist && node ./scripts/web-font-preload.mjs dist && node ./scripts/web-layout-preload.mjs dist",
    "build:analyze": "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1 EXPO_UNSTABLE_TREE_SHAKING=1 expo export --platform web --output-dir dist --source-maps external && node ./scripts/web-font-preload.mjs dist && node ./scripts/web-layout-preload.mjs dist",
    "build:apk": "eas build --platform android --profile apk --local",
    "build:apk:cloud": "eas build --platform android --profile apk",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:preview": "eas build --platform android --profile preview",
    "test": "node ../../node_modules/jest/bin/jest.js --watchAll=false --runInBand",
    "test:coverage": "node ../../node_modules/jest/bin/jest.js --watchAll=false --runInBand --coverage",
    "test:perf": "node --max-old-space-size=6144 ../../node_modules/jest/bin/jest.js -c jest.perf.config.js --runInBand",
    "coverage:check": "node ./scripts/coverage-policy.mjs",
    "coverage:record": "node ./scripts/coverage-policy.mjs --record",
    "coverage:policy-selftest": "node ./scripts/test-coverage-policy.mjs",
    "web-font-preload:selftest": "node ./scripts/test-web-font-preload.mjs",
    "web-layout-preload:selftest": "node ./scripts/test-web-layout-preload.mjs",
    "typecheck": "node ./scripts/typecheck.mjs",
    "lint": "expo lint .",
    "clean": "rm -rf dist .expo",
    "analyze-bundle": "bun ./scripts/analyze-bundle.js"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@oxy\\.so/bloom))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@oxy.so/services/ui/client$": "<rootDir>/../../node_modules/@oxy.so/services/lib/commonjs/ui/client.js",
      "^@oxy.so/core/logger$": "<rootDir>/../../node_modules/@oxy.so/core/dist/cjs/logger/index.js",
      "^@oxy.so/contracts$": "<rootDir>/../../node_modules/@oxy.so/contracts/dist/cjs/index.js",
      "^@oxy.so/contracts/client$": "<rootDir>/../../node_modules/@oxy.so/contracts/dist/cjs/client/index.js",
      "^@oxy.so/stickers$": "<rootDir>/../../node_modules/@oxy.so/stickers/dist/cjs/index.js",
      "^@oxy.so/stickers/react$": "<rootDir>/test-support/stickersReact.js",
      "^@oxy.so/bloom/icons$": "<rootDir>/test-support/bloomIcons.js",
      "^@oxy.so/bloom/icons/(.*)$": "<rootDir>/test-support/bloomIcons.js",
      "^@oxy.so/bloom/empty-state$": "<rootDir>/test-support/bloomEmptyState.js",
      "^@oxy.so/bloom/typography$": "<rootDir>/test-support/bloomTypography.js",
      "^@oxy.so/bloom/sticker$": "<rootDir>/test-support/bloomSticker.js"
    },
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/__tests__/**",
      "!**/__perf__/**",
      "!test-support/perf*",
      "!**/*.test.{ts,tsx}",
      "!**/*.d.ts",
      "!android/**",
      "!ios/**",
      "!dist/**",
      "!.expo/**",
      "!node_modules/**"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 27.8,
        "branches": 23.3,
        "functions": 23.5,
        "lines": 28.4
      },
      "./components/providers/AccountSwitchReset.tsx": {
        "statements": 98.03,
        "branches": 93.18,
        "functions": 100,
        "lines": 100
      },
      "./lib/viewerQueryKeys.ts": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
