// A row of the feed, drawn as Mention's PostItem draws it (components/Feed/PostItem.tsx): the
// repost line, the avatar, the name line, the text, the media, the quoted post and the action
// bar. Its geometry is PostItem's: 12 around, a 36 avatar, the text at 60, and the blocks under
// the text (media, quote, actions) at 64, PostItem's `AVATAR_OFFSET` gutter.

/// The gutter the blocks under the text start at (`AVATAR_OFFSET`: 12 + 40 + 12).
let GUTTER = 64.0
/// The repost line's height, and how far its glyph hangs into the avatar's column.
let CONTEXT_LINE = 18.0
let CONTEXT_HANG = -16.0
/// How far the avatar moves down for each context line (its height and the 4 under it).
let CONTEXT_DROP = 22.0
/// PostItem's media box: at most 420 tall, at least 100 wide; a strip's cells 200 tall.
let MEDIA_MAX = 420.0
let MEDIA_MIN = 100.0
let STRIP_HEIGHT = 200.0
/// The repost pair: each 24 bubble 5.4 off the 36 box's centre (Bloom's cluster layout for two).
let PAIR_SHIFT = 5.4
let PAIR_BACK = -5.4
let PAIR_BOX = 36.0
/// A link card's cover height (Bloom's `LinkPreviewCard`), and its cell's width in the carousel.
let LINK_COVER = 160.0
let LINK_CELL = 280.0
/// Home's feed tabs: a tab's height and its least width.
let TAB_HEIGHT = 38.0
let TAB_MIN = 76.0
/// A plain xs circle button's box (Bloom's `Button(…).size(.xs).shape(.circle)`).
let ICON_BUTTON = 24.0
/// The compose prompt's least height.
let COMPOSER_HEIGHT = 56.0

/// "1.5K": Mention's `formatCompactNumber`, cut to a tenth and never rounded up.
public func compactCount(_ n: Int) -> String {
  if n < 1000 { return "\(n)" }
  if n < 1000000 { return tenths(n, 1000, "K") }
  if n < 1000000000 { return tenths(n, 1000000, "M") }
  return tenths(n, 1000000000, "B")
}

func tenths(_ n: Int, _ unit: Int, _ suffix: String) -> String {
  let whole = n / unit
  let tenth = (n % unit) * 10 / unit
  if tenth == 0 { return "\(whole)\(suffix)" }
  return "\(whole).\(tenth)\(suffix)"
}

/// The name line (PostItem's): the name and its badge, the handle and its account mark, the
/// time, and the edited and repost marks. The handle gives way first, then the name; the time
/// and the marks never do.
struct NameLine: View, Equatable {
  let author: FeedAuthor
  let time: String
  var edited: Bool = false
  var boost: Bool = false

  var body: some View {
    HStack(alignment: .bottom, spacing: .none) {
      Text(author.name).font(.md).weight(.bold).lineLimit(1).shrink(.normal)
      if author.isVerified {
        Icon(.verifiedBadgeFill).size("15").foregroundStyle(.info).padding(.leading, .xs)
      }
      Text(" @\(author.handle)").font(.md).foregroundStyle(.muted).lineLimit(1).shrink(.first)
      if author.isFederated {
        Icon(.fediverse).size("13").foregroundStyle(.muted).padding(.leading, .xs)
      } else if author.isChannel {
        Icon(.megaphone).size("13").foregroundStyle(.muted).padding(.leading, .xs)
      }
      Text("· \(time)").font(.md).foregroundStyle(.muted).lineLimit(1).padding(.leading, .sm)
      if edited {
        Icon(.pencil).size("14").foregroundStyle(.muted).padding(.leading, .sm)
      }
      if boost {
        Icon(.repeat2).size("14").foregroundStyle(.muted).padding(.leading, .sm)
      }
    }
  }
}

/// The body, as runs: links, mentions and tags in the primary ink, each opening its own place.
struct Body: View, Equatable {
  let runs: [FeedRun]
  let onLink: (FeedRun) -> Void

  var body: some View {
    Text(..runs.map { r in
      r.underline
        ? Text(r.text).foregroundStyle(.primary).underline().onPress { onLink(r) }
        : r.kind != ""
          ? Text(r.text).foregroundStyle(.primary).onPress { onLink(r) }
          : r.style == "bold"
          ? Text(r.text).weight(.semibold)
          : r.style == "italic"
            ? Text(r.text).italic()
            : r.style == "strike" ? Text(r.text).strikethrough() : Text(r.text)
    })
      .font(.md)
  }

  static func == (a: Self, b: Self) -> Bool { a.runs == b.runs }
}

/// A link's card (Bloom's `LinkPreviewCard`): the cover, then the site, the title, the
/// description and the byline.
struct LinkCard: View, Equatable {
  let link: FeedLink
  /// In the carousel beside media: the cover fills what the text leaves of the cell
  /// (`LinkPreviewCard`'s `coverFill`).
  var fill: Bool = false

  var body: some View {
    VStack(alignment: .leading, spacing: .none) {
      if let image = link.image {
        if fill {
          Image(image).contentFit(.cover).frame(width: .full).grow().background(.surface)
        } else {
          Image(image).contentFit(.cover).frame(width: .full, height: LINK_COVER).background(.surface)
        }
      }
      VStack(alignment: .leading, spacing: .xs) {
        if !link.site.isEmpty {
          Text(link.site).font(.xs).weight(.medium).foregroundStyle(.muted).lineLimit(1)
        }
        Text(link.title).font(.md).weight(.semibold).lineLimit(2)
        if let description = link.description {
          Text(description).font(.sm).foregroundStyle(.muted).lineLimit(2)
        }
        if let byline = link.byline {
          Text(byline).font(.xs).weight(.medium).foregroundStyle(.muted).lineLimit(1)
        }
      }
      .padding(.md)
    }
    .border(.border, .thin)
    .corner(.xl)
  }
}

/// PostItem's pair for a repost: the author in front, the reposter behind, 36 across.
struct AvatarPair: View, Equatable {
  let author: String
  let booster: String

  var body: some View {
    ZStack {
      Avatar(booster).size(.sm).border(.background, .thin).corner(.full).offset(x: PAIR_SHIFT, y: PAIR_BACK)
      Avatar(author).size(.sm).border(.background, .thin).corner(.full).offset(x: PAIR_BACK, y: PAIR_SHIFT)
    }
    .frame(width: PAIR_BOX, height: PAIR_BOX)
  }
}

/// A picture, or a video's poster, at the column's width (PostItem's single media box).
struct MediaBox: View, Equatable {
  let media: FeedMedia

  var body: some View {
    let aspect = media.aspect > 0.0 ? media.aspect : 1.5556
    ZStack {
      Image(media.url).contentFit(.cover).frame(width: .full).aspectRatio(aspect)
    }
    .frame(maxWidth: max(MEDIA_MAX * aspect, MEDIA_MIN))
    .background(.surface)
    .corner("15")
  }
}

/// Two or more cells: PostItem's carousel (`PostAttachmentsRow`), each picture 200 tall at its
/// own aspect, and a link beside them a 280 card of the same height.
struct MediaStrip: View, Equatable {
  let media: [FeedMedia]
  var link: FeedLink? = none
  let onTap: (Int) -> Void
  var onLink: () -> Void = {}

  var body: some View {
    ScrollArea {
      HStack(spacing: .md) {
        for (i, m) in media.enumerated() {
          Image(m.url)
            .contentFit(.cover)
            .frame(width: max(STRIP_HEIGHT * m.aspect, MEDIA_MIN), height: STRIP_HEIGHT)
            .background(.surface)
            .corner("15")
            .onPress { onTap(i) }
        }
        if let card = link {
          LinkCard(link: card, fill: true)
            .frame(width: LINK_CELL, height: STRIP_HEIGHT)
            .onPress { onLink() }
        }
      }
      .padding(.trailing, .md)
    }
    .axis(.horizontal)
  }
}

/// The post a post quotes, as a card (PostItem `isNested`).
struct QuoteCard: View, Equatable {
  let quote: FeedQuote
  let onOpen: () -> Void

  var body: some View {
    VStack(alignment: .leading, spacing: .xs) {
      HStack(spacing: .sm) {
        Avatar(quote.author.avatar ?? "").size(.xs)
        NameLine(author: quote.author, time: quote.time).shrink(.normal)
      }
      .padding(.horizontal, .md)
      if !quote.text.isEmpty {
        Text(quote.text).font(.md).padding(.horizontal, .md)
      }
      if let first = quote.media.first {
        MediaBox(media: first).padding(.horizontal, .md).padding(.top, .sm)
      }
    }
    .padding(.vertical, .md)
    .border(.border, .hairline)
    .corner(.lg)
    .onPress { onOpen() }
  }
}

/// One row: what PostItem draws for a post, a repost or a quote.
public struct FeedRow: View, Equatable {
  let post: FeedPost
  let onIntent: (FeedIntent) -> Void

  func send(_ kind: String) {
    onIntent(FeedIntent(kind: kind, postId: post.id))
  }

  var body: some View {
    VStack(alignment: .leading, spacing: .none) {
      HStack(alignment: .top, spacing: .none) {
        VStack(spacing: .none) {
          if let booster = post.boosterAvatar {
            AvatarPair(author: post.author.avatar ?? "", booster: booster).onPress { send("profile") }
          } else {
            Avatar(post.author.avatar ?? "", { name: post.author.name }).size(.lg).onPress { send("profile") }
          }
        }
        .padding(.top, post.repostedBy == none ? 0.0 : CONTEXT_DROP)
        VStack(alignment: .leading, spacing: .xs) {
          if let by = post.repostedBy {
            HStack(spacing: "3") {
              Icon(.repeat2).size("13").foregroundStyle(.muted)
              Text("Reposted by \(by)").font(.sm).weight(.semibold).foregroundStyle(.muted).lineLimit(1)
            }
            .frame(height: CONTEXT_LINE)
            .offset(x: CONTEXT_HANG)
            .onPress { send("reposter") }
          }
          NameLine(author: post.author, time: post.time, edited: post.isEdited, boost: post.isBoost)
          if !post.runs.isEmpty {
            Body(runs: post.runs, onLink: { r in
              onIntent(FeedIntent(kind: r.kind == "more" ? "open" : "link", postId: post.id, href: r.href))
            })
          } else if !post.text.isEmpty {
            Text(post.text).font(.md)
          }
        }
        .padding(.leading, .md)
        .shrink(.normal)
        .grow()
        Icon(.moreFill).size("18").foregroundStyle(.muted).padding(.horizontal, .sm).onPress { send("menu") }
      }
      .padding(.horizontal, .md)
      .onPress { send("open") }
      VStack(alignment: .leading, spacing: .md) {
        if post.media.count == 1 && post.link == none {
          MediaBox(media: post.media[0]).onPress { onIntent(FeedIntent(kind: "media", postId: post.id, index: 0)) }
        } else if post.media.count > 0 {
          // Beside media a link is one more cell of the carousel, not a card under it.
          MediaStrip(
            media: post.media,
            link: post.link,
            onTap: { i in onIntent(FeedIntent(kind: "media", postId: post.id, index: i)) },
            onLink: { onIntent(FeedIntent(kind: "link", postId: post.id, href: post.link?.url ?? "")) },
          )
        } else if let link = post.link {
          LinkCard(link: link).onPress { onIntent(FeedIntent(kind: "link", postId: post.id, href: link.url)) }
        }
        if let quote = post.quote {
          QuoteCard(quote: quote, onOpen: { send("quote") })
        }
        ActionBar {
          Action(.like, "Like").count(post.likes).active(post.isLiked).tint(.error).onPress { send("like") }
          // Shown with its count when replies are closed too, as PostItem does; it opens the post.
          Action(.reply, "Reply").count(post.replies).onPress { send(post.canReply ? "reply" : "open") }
          Action(.repost, "Repost").count(post.reposts).active(post.isReposted).tint(.success).onPress { send("repost") }
          Action(.sendPlane, "Send in Allo").onPress { send("send") }
          Action(.share, "Share").onPress { send("share") }
        }
        .trailing {
          Action(.bookmark, "Save").count(post.saves).active(post.isSaved).onPress { send("save") }
        }
        .countFormat(compactCount)
      }
      .padding(.leading, GUTTER)
      .padding(.trailing, .md)
      .padding(.top, post.text.isEmpty ? 4.0 : 12.0)
    }
    .padding(.vertical, .md)
    .border(.border, .hairline, .bottom)
    .onChange(of: post.isLiked) { _, now in
      // Bench: a like drawn (the composition that draws it).
      print("BLOOM_BENCH like-drawn \(post.id) \(now)")
    }
  }

  static func == (a: Self, b: Self) -> Bool { a.post == b.post }
}

/// The rows above the first post: Home's feed tabs (an underline under the active one, a hairline
/// under them all, 38 tall) and the compose prompt, a glass capsule (BloomMaterial) with the
/// reader's avatar, the prompt, the camera and the media buttons.
struct FeedHeaderRows: View, Equatable {
  let header: FeedHeader
  let onIntent: (FeedIntent) -> Void

  func send(_ kind: String, _ href: String) {
    onIntent(FeedIntent(kind: kind, postId: "", href: href))
  }

  var body: some View {
    VStack(alignment: .leading, spacing: .none) {
      if header.tabs.count > 0 {
        // Bloom's underline Tabs, as Home's React Native header draws them: each tab 38 tall, at
        // least 76 wide, its label 12 in from each side; the baseline and the chosen tab's
        // underline are the strip's.
        Tabs(Binding(get: header.active, set: { key in send("tab", key) })) {
          for tab in header.tabs {
            TabItem(tab.key, tab.label)
              .font(.md)
              .leading("18px")
              .weight(tab.key == header.active ? .bold : .medium)
              .padding(.horizontal, .md)
              .frame(height: TAB_HEIGHT, minWidth: TAB_MIN)
          }
        }
        .style(.underline)
        .frame(height: TAB_HEIGHT)
      }
      if header.composer {
        HStack(spacing: .md) {
          Avatar(header.avatar ?? "", { name: header.name }).size(.md)
          Text(header.prompt).font("16").leading("20px").foregroundStyle(.muted).lineLimit(1).grow()
          // FeedHeader's plain xs circle buttons: a 24 box, the camera at the button's 14 and the
          // media glyph at md.
          ZStack { Icon(.camera).size("14") }
            .frame(width: ICON_BUTTON, height: ICON_BUTTON)
            .onPress { send("camera", "") }
          ZStack { Icon(.mediaAttachment).size(.md).foregroundStyle(.muted) }
            .frame(width: ICON_BUTTON, height: ICON_BUTTON)
            .onPress { send("compose", "") }
        }
        .padding(.md)
        .frame(minHeight: COMPOSER_HEIGHT)
        .glass()
        .onPress { send("compose", "") }
        .padding(.md)
      }
    }
  }
}
