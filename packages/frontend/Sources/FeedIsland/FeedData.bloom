// What crosses from the React Native feed into the island, as JSON (`Codable`): the rows'
// posts as the feed store holds them, flattened to what a row draws, and the intents the
// island sends back. `components/Feed/island/feedIslandData.ts` writes the same shapes.

/// A post's author, as the row's header draws it.
public struct FeedAuthor: Codable, Equatable {
  public let id: String
  /// The display name, or the handle when there is none.
  public let name: String
  /// The handle without its `@`.
  public let handle: String
  /// The avatar's URL at the row's variant, none for the placeholder.
  public var avatar: String? = none
  public var isVerified: Bool = false
  /// A fediverse account: its mark after the handle.
  public var isFederated: Bool = false
  /// A local channel: its megaphone after the handle.
  public var isChannel: Bool = false
}

/// A run of a post's body: plain (`kind` empty), an address opened outside the app (`url`), a
/// route of the app (`route`: a mention, a tag) or the "Read more" that opens the post (`more`).
public struct FeedRun: Codable, Equatable {
  public let text: String
  public var kind: String = ""
  public var href: String = ""
  /// Inline markdown's style: `bold`, `italic`, `strike` or none.
  public var style: String = ""
  /// A markdown link is underlined.
  public var underline: Bool = false
}

/// A link's preview card (Bloom's `LinkPreviewCard`).
public struct FeedLink: Codable, Equatable {
  public let url: String
  public let title: String
  public var site: String = ""
  public var description: String? = none
  public var image: String? = none
  public var byline: String? = none
}

/// A picture or a video's poster below the text.
public struct FeedMedia: Codable, Equatable {
  /// `image`, `gif` or `video`.
  public let kind: String
  /// The image, or the video's poster, at the column's variant.
  public let url: String
  /// Width over height; the feed's own fallback (280 / 180) when the media has none.
  public var aspect: Double = 1.5556
  /// A video's stream (HLS when the server has one), played muted in the row.
  public var video: String? = none
}

/// The post a post quotes: drawn as a card under the quoting post's text.
public struct FeedQuote: Codable, Equatable {
  public let id: String
  public let author: FeedAuthor
  public let text: String
  /// The relative time, as Mention's clock formats it ("5m").
  public let time: String
  public var media: [FeedMedia] = []
}

/// One row of the feed.
public struct FeedPost: Codable, Identifiable, Equatable {
  public let id: String
  public let author: FeedAuthor
  public let text: String
  /// The relative time, as Mention's clock formats it ("5m").
  public let time: String
  public var media: [FeedMedia] = []
  public var quote: FeedQuote? = none
  /// The body as runs (its links, mentions and tags in the primary ink); none: `text` alone.
  public var runs: [FeedRun] = []
  public var link: FeedLink? = none
  public var isEdited: Bool = false
  /// A repost: the repost glyph after the time.
  public var isBoost: Bool = false
  /// The reposter's avatar when the row draws the author and the reposter as a pair.
  public var boosterAvatar: String? = none
  /// The reposter's name, when the row is a repost.
  public var repostedBy: String? = none
  public var replies: Int = 0
  public var reposts: Int = 0
  public var likes: Int = 0
  public var saves: Int = 0
  public var isLiked: Bool = false
  public var isReposted: Bool = false
  public var isSaved: Bool = false
  public var canReply: Bool = true
}

/// One of the screen's feed tabs (Home's): its key and its label.
public struct FeedTab: Codable, Equatable {
  public let key: String
  public let label: String
}

/// The rows above the first post, as Feed's own list draws them: the screen's tabs, then the
/// compose prompt (signed in only), with the reader's avatar and the prompt's text.
public struct FeedHeader: Codable, Equatable {
  public var tabs: [FeedTab] = []
  public var active: String = ""
  public var composer: Bool = false
  public var avatar: String? = none
  /// The reader's name: the initial and tint of the avatar's disc when it has no picture.
  public var name: String = ""
  public var prompt: String = ""
}

/// What the island is drawn from.
public struct FeedIslandProps: Codable, Equatable {
  public let posts: [FeedPost]
  /// The room the screen's chrome takes over the list: its header and its bottom bar.
  public var topInset: Double = 0.0
  public var bottomInset: Double = 0.0
  public var header: FeedHeader? = none
}

/// What a reader did in the island, for React Native to carry out: `like`, `repost`, `reply`,
/// `save`, `share`, `open` (the post), `profile` (the author), `media` (with its index),
/// `quote` (the quoted post), `reposter`, `menu` and `more` (the end is near).
public struct FeedIntent: Codable, Equatable {
  public let kind: String
  public let postId: String
  public var index: Int = 0
  /// A link's address or route (`link`).
  public var href: String = ""
}
