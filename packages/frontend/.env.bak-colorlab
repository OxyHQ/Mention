# DEV REVIEW OVERRIDE (uncommitted): point the frontend at the LOCAL seeded
# backend so the anonymous for_you feed loads the 400 local posts for live
# review of the web document-scroll virtualization. Restore from
# .env.review-backup before committing/pushing.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_OXY_BASE_URL=https://api.oxy.so
EXPO_PUBLIC_OXY_AUTH_URL=https://auth.oxy.so
# Mention's registered Oxy OAuth clientId — MUST be the ApplicationCredential
# publicKey (oxy_dk_…), NOT the Application's Mongo ObjectId. The previous value
# (6a2f851751b784a86fd0e916, the Application id) 404'd on
# GET /auth/oauth/client/:clientId → "Invalid Application" on Sign in with Oxy.
# Same value as the committed default in config.ts.
EXPO_PUBLIC_OXY_CLIENT_ID=oxy_dk_ba07b16e89bd180d2b58c09b02db550e727fa598ed73e2f2
API_URL_SOCKET=ws://localhost:3000
