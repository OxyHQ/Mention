        "EXPO_PUBLIC_OXY_CLIENT_ID": "oxy_dk_463c7d9366ca7cfd442da884d4963dc78dca829412fd1125",
        "EXPO_PUBLIC_MENTION_PLUS_PRODUCT_ID": "mention",
        "EXPO_PUBLIC_MENTION_PLUS_CAPABILITY_KEY": "plus",
