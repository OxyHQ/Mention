<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen sizes for the three trends widgets, in the launcher's own grid units.

  Every value below is `70 × cells − 30` dp, the conversion the App Widget
  sizing guide gives for turning a cell count into the `minWidth` / `minHeight`
  a provider must declare (developer.android.com/develop/ui/views/appwidgets
  § "Determine widget sizing"). They are written out rather than computed so the
  cell count each one stands for is stated once, here:

      2 cells → 110dp    3 cells → 180dp    4 cells → 250dp    5 cells → 320dp

  The same four numbers are the width/height axes of each variant's `sizeMode`, so
  a placement the launcher allows always lands on a breakpoint the widget was
  designed for.
-->
<resources>
  <!--
    The resize range is shared: all three variants are designed from 2×2 up to 5×5.
    The floor is the size each one turns into its smallest form at (one row, one
    chip, a compact headline); the ceiling is where each one runs out of content to
    reveal, so a larger placement would only stretch what is already there.
  -->
  <dimen name="mention_trends_widget_min_resize_width">110dp</dimen>
  <dimen name="mention_trends_widget_min_resize_height">110dp</dimen>
  <dimen name="mention_trends_widget_max_resize_width">320dp</dimen>
  <dimen name="mention_trends_widget_max_resize_height">320dp</dimen>

  <!-- Variant A, the ranked list. Default placement 4 cells wide, 3 tall: two rows. -->
  <dimen name="mention_trends_list_widget_min_width">250dp</dimen>
  <dimen name="mention_trends_list_widget_min_height">180dp</dimen>

  <!-- Variant C, the chip cloud. Same default: two rows of chips. -->
  <dimen name="mention_trends_chips_widget_min_width">250dp</dimen>
  <dimen name="mention_trends_chips_widget_min_height">180dp</dimen>

  <!-- Variant J, the tonal card. Wide and short — 4 cells by 2. -->
  <dimen name="mention_trends_card_widget_min_width">250dp</dimen>
  <dimen name="mention_trends_card_widget_min_height">110dp</dimen>

  <!--
    How short the user may drag the LIST and the CARD.

    Derived, not chosen: `rowsThatFit` charges 12dp of padding top and bottom and a 48dp
    row (Material's minimum touch target), so 72dp is the shortest height at which either
    widget can still show one COMPLETE row. Below that it would be showing a clipped one.

    They get their own value rather than sharing `mention_trends_widget_min_resize_height`
    because that floor is 110dp — two launcher cells — and both of these degrade honestly
    to a single headline, so two cells was costing the user a placement they could use.
    The chips widget keeps the shared 110dp: its content is a flowing row of chips, and one
    cell of height would give it a single chip, which is a worse thing than a short list.
  -->
  <dimen name="mention_trends_list_widget_min_resize_height">72dp</dimen>
  <dimen name="mention_trends_card_widget_min_resize_height">72dp</dimen>
</resources>
