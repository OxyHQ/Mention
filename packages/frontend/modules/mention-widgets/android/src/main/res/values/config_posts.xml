<?xml version="1.0" encoding="utf-8"?>
<!--
  The media origin the trending-posts widget loads pictures from.

  WHY THIS EXISTS AT ALL. The ecosystem has one chokepoint for media URLs —
  `oxyServices.getFileDownloadUrl(id, variant)` — and nothing is supposed to build such a URL
  itself. A widget cannot call it: it runs outside the JS runtime, in a `BroadcastReceiver`
  and a WorkManager job, potentially before the app has ever been opened. So the origin is a
  string resource, exactly as `config.xml` already mirrors `API_URL` and `WEB_BASE_URL` for
  the same reason, and `oxyFileUrl` in `PostsPresentation.kt` is the single place that
  composes it.

  It is needed for ONE field: the author's avatar, which arrives in the DTO as a bare Oxy
  file id. Everything else the card draws — a media item's `thumbUrl`, a link preview's
  `image` — is absolute and server-resolved before it reaches the widget, and is used
  verbatim.

  This origin is also half of the download allowlist in `PostsImageCache`: the widget will
  fetch a picture from here or from the configured API origin, and from nowhere else.

  Overriding it needs no plugin change — an app-module string of the same name wins over a
  library dependency's at merge time, which is the mechanism `app.plugin.js` already uses for
  the other two origins.
-->
<resources>
  <string name="mention_widget_media_base_url" translatable="false">https://cloud.oxy.so</string>
</resources>
