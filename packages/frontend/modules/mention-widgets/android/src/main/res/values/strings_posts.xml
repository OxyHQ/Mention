<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings for the trending-POSTS widget.

  Its own file rather than more entries in `strings.xml`: Android merges everything under
  `res/values/`, so a widget family gets its own file and the trends family keeps theirs.
-->
<resources>
  <!--
    What the launcher's widget picker shows. The label has to distinguish this from the
    three trends widgets, which show trending TOPICS — this one shows trending POSTS.
  -->
  <string name="mention_posts_widget_label">Trending posts</string>
  <string name="mention_posts_widget_description">One trending post at a time, from Mention\'s Explore feed.</string>

  <!--
    The brand row, above the post. All caps in the string itself: Glance's `TextStyle` has
    no text-transform, and uppercasing per locale in code is not something a widget can do
    correctly without one.
  -->
  <string name="mention_posts_widget_eyebrow">TRENDING</string>

  <!-- Shown only before the first successful fetch; never replaces content. -->
  <string name="mention_posts_widget_empty">No posts yet</string>
  <string name="mention_posts_widget_open_app">Open Mention</string>

