<?xml version="1.0" encoding="utf-8"?>
<!--
  Default placement for the trending-posts widget on API 31+, expressed directly in launcher
  cells rather than through the `70 × cells − 30` dp conversion the older attributes need.
  The pair matches `mention_posts_widget_min_width` / `_min_height` in dimens_posts.xml.
-->
<resources>
  <integer name="mention_posts_widget_target_cell_width">4</integer>
  <integer name="mention_posts_widget_target_cell_height">3</integer>

  <!--
    How long the trending-posts card waits before turning to the next post on its own.

    Thirty seconds: long enough that a redraw — which re-serialises this widget's decoded
    bitmaps to the launcher, see PostsBitmapBudget.kt — is not paid twelve times a minute,
    and short enough that the rotation visibly moves while someone is looking at it. It is a
    resource so the pace can be tuned without touching the scheduler.

    NOT expressible as periodic work: WorkManager floors that at fifteen minutes, which is
    why PostsAutoAdvanceWorker chains one-time requests instead.
  -->
  <integer name="mention_posts_widget_auto_advance_seconds">30</integer>
</resources>
