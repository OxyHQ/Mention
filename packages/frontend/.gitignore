# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# CNG prebuild output — the generated native projects at the PACKAGE ROOT only.
# Anchored with a leading slash on purpose: an unanchored `android/` matches at
# any depth, which would also swallow the hand-written native source of the local
# Expo modules under `modules/*/android/` (that source is checked in — it is the
# input to prebuild, not its output).
/android/
/ios/
