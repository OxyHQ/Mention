import { type GeoJSONPoint } from "@mention/shared-types"

/// A post's place: a pin and its address (or its coordinates when it has none) on one muted
/// line. Nothing when the point has no coordinates.
public func postLocation(_ location: GeoJSONPoint) -> View? {
  if !(location?.coordinates.0 == none ||
    location?.coordinates.0 == 0 ||
    location?.coordinates.1 == none ||
    location?.coordinates.1 == 0) {
    let longitude = location.coordinates.0
    let latitude = location.coordinates.1
    let displayText = location.address ||
      "\(latitude.formatted(fractionDigits: 4)), \(longitude.formatted(fractionDigits: 4))"
    HStack(alignment: .center) {
      Icon(.mapPin).size("14").margin(.right, .xs).foreground(.muted)
      RawText(displayText).foreground(.muted).font(.sm).flex("1").lines(1)
    }
    .padding(.vertical, .xs)
  }
}
