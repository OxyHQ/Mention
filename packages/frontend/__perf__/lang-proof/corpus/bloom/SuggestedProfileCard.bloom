// Printed by bloom migrate from components/SuggestedProfileCard.tsx (needs review); relative imports as @/ paths. DEV ONLY.
import { useResolvedProfileIdentity, type ProfileCardData } from "@/components/ProfileCard"
import { default as UserName } from "@/components/UserName"
import { FollowButton } from "@/components/FollowButton"
import { AccountAvatar } from "@/components/ui/AccountAvatar"
import { getUserPlaceholderColor } from "@/utils/userPlaceholderColor"
import { MEDIA_VARIANT_AVATAR } from "@mention/shared-types/post"
import { defineModifier } from "@oxy.so/bloom-language"
import { PressableScale } from "@oxy.so/bloom/pressable-scale"
import * as Skeleton from "@oxy.so/bloom/skeleton"
import { StyleSheet, type ViewStyle } from "react-native"

private let AVATAR_SIZE = 64

/// Two lines of bio, reserved even when there is none, so every tile in a row
/// puts its Follow button at the same height.
private let BIO_LINES = 2

private let BIO_LINE_HEIGHT = 18

/// The tile's identity: the name on a 20pt line over a 13/18 handle, across the tile.
private let IDENTITY_NAME = defineModifier { v: View in v.leading("20px") }

private let IDENTITY_HANDLE = defineModifier { v: View in v.font(.sm).leading("18px") }

private let IDENTITY_COLUMN = defineModifier { v: View in v.alignSelf(.stretch) }

/// The skeleton's lines, at the identity's type sizes.
private let SKELETON_LINES = StyleSheet.create(
  name: { fontSize: 15, fontWeight: "700", lineHeight: 20 },
  handle: { fontSize: 13, lineHeight: 18 },
)

/// The tile, as `flex-1 items-center gap-2` drew it.
private let TILE_STYLE: ViewStyle = {
  flexGrow: 1,
  flexShrink: 1,
  flexBasis: "0%",
  alignItems: "center",
  gap: 8,
}

private let styles = StyleSheet.create(followButton: { alignSelf: "stretch" })

// Overrides the default push to the profile.
// Called when the viewer follows or unfollows from this tile.
// Overlaid in the top-right corner (the dismiss X).

/// The person tile — one suggested account as a vertical card: avatar on top,
/// name and handle, two lines of bio, a full-width Follow button. It is the card
/// X and Instagram put in their "Who to follow" rows, and the feed's suggestion
/// carousels are its surface; lists of people keep the {@link ProfileCard} row.
///
/// It resolves its identity exactly as the row does
/// ({@link useResolvedProfileIdentity}), so an edit made in this session and the
/// "Unknown user" fallback reach both the same way.
///
/// The Follow button and the accessory are SIBLINGS of the pressable region, not
/// descendants: on web a real `<button>` would otherwise bubble its click into
/// the tile and navigate away.
public struct SuggestedProfileCard: View {
  let profile: ProfileCardData
  var onPress: (() -> Unit)? = none
  var onFollowChange: ((Bool) -> Unit)? = none
  var accessory: View? = none
  let { resolved, handle, nameLabel, press } = useResolvedProfileIdentity(profile, onPress)
  let bio = resolved.description?.trim()

  var body: some View {
    // bloom: review: `|| undefined` dropped: a falsy value (`""`, `0`) is kept, not `none`
    // bloom: review: `|| undefined` dropped: a falsy value (`""`, `0`) is kept, not `none`
    // bloom: review: `|| undefined` dropped: a falsy value (`""`, `0`) is kept, not `none`
    VStack {
      // Bloom's PressableScale as JSX: an inert tile (no route) is a pressable with no role,
      // which a language press host cannot be (it names itself a button).
      PressableScale(
        onPress: press,
        disabled: false,
        accessibilityRole: "link",
        style: TILE_STYLE,
      ) {
        AccountAvatar(
          account: resolved,
          source: resolved.avatar,
          size: AVATAR_SIZE,
          variant: MEDIA_VARIANT_AVATAR,
          verified: resolved.verified,
          placeholderColor: getUserPlaceholderColor(resolved),
        )
        UserName(
          name: nameLabel,
          handle: handle,
          verified: resolved.verified,
          isFederated: resolved.isFederated,
          kind: resolved.kind,
          isAgent: resolved.isAgent,
          isAutomated: resolved.isAutomated,
          align: "center",
          look: IDENTITY_COLUMN,
          nameLook: IDENTITY_NAME,
          handleLook: IDENTITY_HANDLE,
        )
        Text(
          // BIO_LINES lines of BIO_LINE_HEIGHT (18px), the box held at both (36) when shorter.
          bio ?? "",
        )
        .foregroundStyle(.muted)
        .textAlign(.center)
        .font(.sm)
        .leading("18px")
        .alignSelf(.stretch)
        .frame(minHeight: "36")
        .lineLimit(BIO_LINES)
      }
      FollowButton(
        userId: resolved.id,
        username: handle,
        size: "sm",
        style: styles.followButton,
        onFollowChange: onFollowChange,
      )
      Embed(accessory)
    }
    .padding(.all, .md)
    .background(.card)
    .border(.border, .thin)
    .corner(.md)
    .flex("1")
    .spacing(.md)
  }
}

/// The loading placeholder for {@link SuggestedProfileCard}, with the same
/// geometry, so the row never shifts when the real tiles land.
public struct SuggestedProfileCardSkeleton: View {
  var body: some View {
    VStack {
      VStack(alignment: .center) {
        Skeleton.Circle(size: AVATAR_SIZE)
        Skeleton.Text(style: [SKELETON_LINES.name, { width: 110 }])
        Skeleton.Text(style: [SKELETON_LINES.handle, { width: 80 }])
        Skeleton
        .Col(style: { gap: 0, alignItems: "center", minHeight: BIO_LINES * BIO_LINE_HEIGHT }) {
          Skeleton.Text(style: { width: 130, fontSize: 13, lineHeight: BIO_LINE_HEIGHT })
          Skeleton.Text(style: { width: 90, fontSize: 13, lineHeight: BIO_LINE_HEIGHT })
        }
      }
      .spacing(.sm)
      Skeleton.Pill(size: 32, style: { alignSelf: "stretch" })
    }
    .padding(.all, .md)
    .background(.card)
    .border(.border, .thin)
    .corner(.md)
    .spacing(.md)
  }
}
