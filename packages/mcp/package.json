{
  "name": "@mention/mcp",
  "version": "1.0.0",
  "description": "MCP server for Mention social platform",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/server-http.js",
  "dependencies": {
    "@mention/shared-types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@oxyhq/core": "catalog:",
    "jsonwebtoken": "catalog:",
    "zod": "catalog:"
  },
  "scripts": {
    "start": "bun server.ts",
    "start:http": "bun server-http.ts",
    "start:compiled": "bun dist/server-http.js",
    "dev": "bun --watch server.ts",
    "dev:http": "bun --watch server-http.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
