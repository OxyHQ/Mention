{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "resolveJsonModule": true,
    // Runs on Bun in the mention-mcp image, same as the backend.
    "types": ["node", "bun"]
  },
  "include": ["*.ts", "lib/**/*.ts", "tools/**/*.ts", "__tests__/**/*.ts"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
