{
  "name": "mention",
  "version": "2.0.0",
  "description": "Mention frontend, backend, shared contracts, and MCP server",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@oxy.so/bloom": "15.79.1",
      "@oxy.so/contracts": "6.1.0",
      "@oxy.so/core": "7.9.1",
      "@oxy.so/mcp": "1.4.0",
      "@oxy.so/services": "13.14.1",
      "@oxy.so/utils": "^1.4.0",
      "@syra.fm/sdk": "0.24.0",
      "@types/bun": "1.4.3",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/node": "^26.6.5",
      "jsonwebtoken": "^9.0.3",
      "typescript": "~6.0.3",
      "zod": "^4.6.7",
      "@oxy.so/protocol": "1.5.1"
    }
  },
  "scripts": {
    "dev": "bun run --no-orphans --filter '*' dev",
    "dev:frontend": "bun run --no-orphans --cwd packages/frontend dev",
    "dev:backend": "bun run --no-orphans --cwd packages/backend dev",
    "build": "bun run build:shared-types && bun run build:publishing && bun run --cwd packages/backend build && bun run --cwd packages/mcp build",
    "build:shared-types": "bun run --cwd packages/contracts build && bun run --cwd packages/shared-types build",
    "build:frontend": "bun run --cwd packages/frontend build",
    "build:backend": "bun run build:shared-types && bun run --cwd packages/backend build",
    "audit:security": "node --test ./scripts/security-audit-policy.test.mjs && bun ./scripts/audit-security.mjs",
    "doctor": "bun ./scripts/doctor.mjs",
    "doctor:oxy": "oxy-doctor --ci",
    "check": "bun run check:workspace && bun run build && bun run check:types",
    "check:workspace": "bun run --parallel doctor validate:workflows validate:lockfile validate:i18n validate:logger validate:suite-collection validate:id-shape validate:license validate:architecture-boundaries validate:inference-boundary validate:commerce-boundary validate:feed-hot-path validate:bun-pins test:shell-worker audit:security",
    "check:types": "bun run --parallel typecheck:frontend lint:shared-types lint:backend lint:mcp lint:e2e && bun run lint:frontend",
    "test": "bun run --parallel test:shared-types test:backend test:mcp test:frontend",
    "test:shared-types": "bun run --cwd packages/shared-types test",
    "test:backend": "bun run --cwd packages/backend test",
    "test:mcp": "bun run --cwd packages/mcp test",
    "test:frontend": "bun run --cwd packages/frontend test",
    "test:e2e": "bun run --cwd packages/e2e test",
    "validate:workflows": "bun ./scripts/validate-workflows.mjs",
    "validate:lockfile": "bun ./scripts/validate-lockfile.mjs",
    "validate:i18n": "bun ./scripts/validate-i18n.mjs && bun ./scripts/test-validate-i18n.mjs",
    "validate:logger": "bun ./scripts/validate-logger-error-args.mjs && bun ./scripts/test-validate-logger-error-args.mjs",
    "validate:id-shape": "bun ./scripts/validate-id-shape.mjs && bun ./scripts/test-validate-id-shape.mjs",
    "validate:architecture-boundaries": "bun ./scripts/validate-architecture-boundaries.mjs && bun ./scripts/test-validate-architecture-boundaries.mjs",
    "validate:inference-boundary": "bun ./scripts/validate-inference-boundary.mjs && bun ./scripts/test-validate-inference-boundary.mjs",
    "validate:commerce-boundary": "bun ./scripts/validate-commerce-boundary.mjs && bun ./scripts/test-validate-commerce-boundary.mjs",
    "validate:feed-hot-path": "bun ./scripts/validate-feed-hot-path.mjs && bun ./scripts/test-validate-feed-hot-path.mjs",
    "validate:license": "bun ./scripts/validate-license.mjs",
    "validate:bun-pins": "bun ./scripts/validate-bun-pins.mjs && bun ./scripts/test-validate-bun-pins.mjs",
    "test:shell-worker": "node --test ./scripts/shell-worker.test.mjs",
    "validate:suite-collection": "bun ./scripts/test-validate-suite-collection.mjs",
    "check:suite-collection": "bun ./scripts/validate-suite-collection.mjs",
    "typecheck:frontend": "bun run --cwd packages/frontend typecheck",
    "lint": "biome check . && bun run --parallel lint:shared-types lint:backend lint:mcp lint:e2e && bun run lint:frontend",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint:shared-types": "bun run --cwd packages/shared-types lint",
    "lint:backend": "bun run --cwd packages/backend lint",
    "lint:mcp": "bun run --cwd packages/mcp lint",
    "lint:frontend": "bun run --cwd packages/frontend lint",
    "lint:e2e": "bun run --cwd packages/e2e lint",
    "clean": "bun run clean:artifacts && bun run clean:deps",
    "clean:artifacts": "bun run --filter '*' clean",
    "clean:deps": "rm -rf node_modules packages/*/node_modules",
    "install:all": "bun install",
    "start:frontend": "bun run --cwd packages/frontend start",
    "start:backend": "bun run --cwd packages/backend start",
    "start:mcp": "bun run --cwd packages/mcp start",
    "start:mcp:http": "bun run --cwd packages/mcp start:http",
    "dev:mcp": "bun run --no-orphans --cwd packages/mcp dev",
    "dev:mcp:http": "bun run --no-orphans --cwd packages/mcp dev:http",
    "postinstall": "bun run build:shared-types && bun run build:publishing",
    "build:publishing": "bun run --cwd packages/sdk build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@oxy.so/doctor": "1.2.0",
    "@types/node": "catalog:",
    "semver": "^7.8.5",
    "typescript": "catalog:",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "proxy-addr": "2.0.8",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "58.0.2",
    "expo-file-system": "58.0.11",
    "expo-modules-core": "58.0.26",
    "expo-constants": "58.0.13",
    "expo-asset": "58.0.18",
    "expo-font": "58.0.10",
    "expo-linking": "58.0.13",
    "@expo/log-box": "58.0.13",
    "expo": "58.0.19",
    "@expo/config-plugins": "58.0.10",
    "react-native-svg": "15.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/metro-babel-transformer": "0.88.0",
    "metro": "0.87.1",
    "metro-babel-transformer": "0.87.1",
    "metro-cache": "0.87.1",
    "metro-cache-key": "0.87.1",
    "metro-config": "0.87.1",
    "metro-core": "0.87.1",
    "metro-file-map": "0.87.1",
    "metro-minify-terser": "0.87.1",
    "metro-resolver": "0.87.1",
    "metro-runtime": "0.87.1",
    "metro-source-map": "0.87.1",
    "metro-symbolicate": "0.87.1",
    "metro-transform-plugins": "0.87.1",
    "metro-transform-worker": "0.87.1",
    "ob1": "0.87.1",
    "@oxy.so/bloom": "catalog:",
    "@oxy.so/core": "7.9.1",
    "@oxy.so/services": "13.14.1",
    "fast-uri": "3.1.8",
    "fast-xml-parser": "5.11.1",
    "ioredis": "6.0.0",
    "postcss": "8.5.28",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1",
    "ip-address": "10.7.2",
    "socket.io-parser": "4.2.7",
    "nanoid": "3.3.19",
    "browserslist": "4.29.1",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/query-core": "5.104.3",
    "@tanstack/query-persist-client-core": "5.104.3",
    "@tanstack/query-async-storage-persister": "5.104.3",
    "@tanstack/react-query-persist-client": "5.104.3",
    "@oxy.so/contracts": "catalog:",
    "@grpc/grpc-js": "1.14.5",
    "@fastify/busboy": "3.2.2",
    "@oxy.so/protocol": "catalog:",
    "react-native-css": "3.1.0-rc.0",
    "vite": "8.1.6"
  },
  "patchedDependencies": {
    "expo-router@58.0.24": "patches/expo-router@58.0.24.patch",
    "expo-video@58.0.12": "patches/expo-video@58.0.12.patch",
    "react-native-screens@4.30.0": "patches/react-native-screens@4.30.0.patch",
    "@shopify/flash-list@2.3.2": "patches/@shopify%2Fflash-list@2.3.2.patch",
    "react-native-gesture-handler@3.3.0": "patches/react-native-gesture-handler@3.3.0.patch",
    "react-native-css@3.1.0-rc.0": "patches/react-native-css@3.1.0-rc.0.patch"
  }
}
