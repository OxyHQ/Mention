{
  "name": "mention",
  "version": "2.0.0",
  "description": "Mention frontend, backend, shared contracts, and MCP server",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@oxyhq/bloom": "^1.10.1",
      "@oxyhq/contracts": "^0.40.0",
      "@oxyhq/core": "^23.2.1",
      "@oxyhq/mcp": "^0.5.0",
      "@oxyhq/services": "^30.2.5",
      "@syra.fm/sdk": "^0.7.0",
      "@types/bun": "1.3.14",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/node": "^26.1.1",
      "jsonwebtoken": "^9.0.3",
      "typescript": "~6.0.3",
      "zod": "^4.5.4"
    }
  },
  "scripts": {
    "dev": "bun run --no-orphans --filter '*' dev",
    "dev:frontend": "bun run --no-orphans --cwd packages/frontend dev",
    "dev:backend": "bun run --no-orphans --cwd packages/backend dev",
    "build": "bun run build:shared-types && bun run --cwd packages/backend build && bun run --cwd packages/mcp build",
    "build:shared-types": "bun run --cwd packages/shared-types build",
    "build:frontend": "bun run --cwd packages/frontend build",
    "build:backend": "bun run build:shared-types && bun run --cwd packages/backend build",
    "audit:security": "bun ./scripts/audit-security.mjs",
    "doctor": "bun ./scripts/doctor.mjs",
    "check": "bun run check:workspace && bun run build && bun run check:types",
    "check:workspace": "bun run --parallel doctor validate:workflows validate:lockfile validate:i18n validate:logger validate:suite-collection validate:no-mongo validate:license validate:architecture-boundaries validate:inference-boundary audit:security",
    "check:types": "bun run --parallel typecheck:frontend lint:shared-types lint:backend lint:mcp lint:e2e && bun run lint:frontend",
    "test": "bun run --parallel test:shared-types test:backend test:mcp test:frontend",
    "test:shared-types": "bun run --cwd packages/shared-types test",
    "test:backend": "bun run --cwd packages/backend test",
    "test:mcp": "bun run --cwd packages/mcp test",
    "test:frontend": "bun run --cwd packages/frontend test",
    "test:e2e": "bun run --cwd packages/e2e test",
    "validate:workflows": "bun ./scripts/validate-workflows.mjs",
    "validate:lockfile": "bun ./scripts/validate-lockfile.mjs",
    "validate:i18n": "bun ./scripts/validate-i18n.mjs && bun ./scripts/test-validate-i18n.mjs",
    "validate:logger": "bun ./scripts/validate-logger-error-args.mjs && bun ./scripts/test-validate-logger-error-args.mjs",
    "validate:no-mongo": "bun ./scripts/validate-no-mongo.mjs && bun ./scripts/test-validate-no-mongo.mjs",
    "validate:architecture-boundaries": "bun ./scripts/validate-architecture-boundaries.mjs && bun ./scripts/test-validate-architecture-boundaries.mjs",
    "validate:inference-boundary": "bun ./scripts/validate-inference-boundary.mjs && bun ./scripts/test-validate-inference-boundary.mjs",
    "validate:license": "bun ./scripts/validate-license.mjs",
    "validate:suite-collection": "bun ./scripts/test-validate-suite-collection.mjs",
    "check:suite-collection": "bun ./scripts/validate-suite-collection.mjs",
    "typecheck:frontend": "bun run --cwd packages/frontend typecheck",
    "lint": "bun run --parallel lint:shared-types lint:backend lint:mcp lint:e2e && bun run lint:frontend",
    "lint:shared-types": "bun run --cwd packages/shared-types lint",
    "lint:backend": "bun run --cwd packages/backend lint",
    "lint:mcp": "bun run --cwd packages/mcp lint",
    "lint:frontend": "bun run --cwd packages/frontend lint",
    "lint:e2e": "bun run --cwd packages/e2e lint",
    "clean": "bun run clean:artifacts && bun run clean:deps",
    "clean:artifacts": "bun run --filter '*' clean",
    "clean:deps": "rm -rf node_modules packages/*/node_modules",
    "install:all": "bun install",
    "start:frontend": "bun run --cwd packages/frontend start",
    "start:backend": "bun run --cwd packages/backend start",
    "start:mcp": "bun run --cwd packages/mcp start",
    "start:mcp:http": "bun run --cwd packages/mcp start:http",
    "dev:mcp": "bun run --no-orphans --cwd packages/mcp dev",
    "dev:mcp:http": "bun run --no-orphans --cwd packages/mcp dev:http",
    "postinstall": "bun run build:shared-types"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "semver": "^7.8.5",
    "typescript": "catalog:",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "57.0.3",
    "expo-file-system": "57.0.6",
    "expo-modules-core": "57.0.15",
    "expo-constants": "57.0.17",
    "expo-asset": "57.0.16",
    "expo-font": "57.0.3",
    "expo-linking": "57.0.9",
    "@expo/log-box": "57.0.4",
    "react-native-svg": "15.15.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-babel-transformer": "0.86.3",
    "metro": "0.84.5",
    "metro-babel-transformer": "0.84.5",
    "metro-cache": "0.84.5",
    "metro-cache-key": "0.84.5",
    "metro-config": "0.84.5",
    "metro-core": "0.84.5",
    "metro-file-map": "0.84.5",
    "metro-minify-terser": "0.84.5",
    "metro-resolver": "0.84.5",
    "metro-runtime": "0.84.5",
    "metro-source-map": "0.84.5",
    "metro-symbolicate": "0.84.5",
    "metro-transform-plugins": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "ob1": "0.84.5",
    "@oxyhq/bloom": "catalog:",
    "@oxyhq/core": "^23.2.1",
    "@oxyhq/services": "^30.2.5",
    "fast-uri": "3.1.6",
    "fast-xml-parser": "5.10.1",
    "linkify-it": "5.0.2",
    "ioredis": "5.11.1",
    "postcss": "8.5.18",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1",
    "ip-address": "10.3.1",
    "socket.io-parser": "4.2.7",
    "nanoid": "3.3.18",
    "browserslist": "4.28.8",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/query-core": "5.102.8",
    "@tanstack/query-persist-client-core": "5.102.8",
    "@tanstack/query-async-storage-persister": "5.102.8",
    "@tanstack/react-query-persist-client": "5.102.8"
  },
  "dependencies": {},
  "patchedDependencies": {
    "expo-router@57.0.18": "patches/expo-router@57.0.18.patch",
    "expo-video@57.0.3": "patches/expo-video@57.0.3.patch"
  }
}
