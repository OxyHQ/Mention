{
  "name": "mention",
  "version": "2.0.0",
  "description": "Mention frontend, backend, shared contracts, and MCP server",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun run --cwd packages/frontend dev",
    "dev:backend": "bun run --cwd packages/backend dev",
    "build": "bun run build:shared-types && bun run --cwd packages/backend build && bun run --cwd packages/mcp build",
    "build:shared-types": "bun run --cwd packages/shared-types build",
    "build:frontend": "bun run --cwd packages/frontend build",
    "build:backend": "bun run build:shared-types && bun run --cwd packages/backend build",
    "audit:security": "bun ./scripts/audit-security.mjs",
    "doctor": "bun ./scripts/doctor.mjs",
    "check": "bun run doctor && bun run validate:workflows && bun run validate:lockfile && bun run validate:i18n && bun run validate:logger && bun run audit:security && bun run build && bun run --cwd packages/frontend typecheck && bun run lint",
    "test": "bun run test:shared-types && bun run test:backend && bun run test:mcp && bun run test:frontend",
    "test:shared-types": "bun run --cwd packages/shared-types test",
    "test:backend": "bun run --cwd packages/backend test",
    "test:mcp": "bun run --cwd packages/mcp test",
    "test:frontend": "bun run --cwd packages/frontend test",
    "test:e2e": "bun run --cwd packages/e2e test",
    "validate:workflows": "bun ./scripts/validate-workflows.mjs",
    "validate:lockfile": "bun ./scripts/validate-lockfile.mjs",
    "validate:i18n": "bun ./scripts/validate-i18n.mjs",
    "validate:logger": "bun ./scripts/validate-logger-error-args.mjs && bun ./scripts/test-validate-logger-error-args.mjs",
    "lint": "bun run lint:shared-types && bun run lint:backend && bun run lint:mcp && bun run lint:frontend && bun run lint:e2e",
    "lint:shared-types": "bun run --cwd packages/shared-types lint",
    "lint:backend": "bun run --cwd packages/backend lint",
    "lint:mcp": "bun run --cwd packages/mcp lint",
    "lint:frontend": "bun run --cwd packages/frontend lint",
    "lint:e2e": "bun run --cwd packages/e2e lint",
    "clean": "bun run clean:artifacts && bun run clean:deps",
    "clean:artifacts": "bun run --filter '*' clean",
    "clean:deps": "rm -rf node_modules packages/*/node_modules",
    "install:all": "bun install",
    "start:frontend": "bun run --cwd packages/frontend start",
    "start:backend": "bun run --cwd packages/backend start",
    "start:mcp": "bun run --cwd packages/mcp start",
    "start:mcp:http": "bun run --cwd packages/mcp start:http",
    "dev:mcp": "bun run --cwd packages/mcp dev",
    "dev:mcp:http": "bun run --cwd packages/mcp dev:http",
    "postinstall": "bun run build:shared-types"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "~5.9.3",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "56.0.4",
    "expo-file-system": "56.0.8",
    "expo-modules-core": "56.0.21",
    "react-native-svg": "15.15.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/metro-babel-transformer": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@oxyhq/bloom": "^0.72.2",
    "@oxyhq/core": "^16.0.0",
    "@oxyhq/services": "^25.0.0",
    "brace-expansion": "2.1.2",
    "fast-uri": "3.1.4",
    "fast-xml-parser": "5.10.1",
    "linkify-it": "5.0.2",
    "mongoose": "^8.17.0",
    "ioredis": "5.11.1",
    "postcss": "8.5.18",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1"
  },
  "dependencies": {}
}
